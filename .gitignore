# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Environment — never commit real values, only .env.example
.env
.env.*
!.env.example

# Prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal
# The Prisma 7 client is generated TypeScript rather than a binary binding,
# so it is real source — but it is source `prisma generate` rewrites from
# schema.prisma on every install and build, and committing it would put a
# few thousand lines into every schema diff. Migrations, which ARE the
# history, are committed.
packages/db/src/generated/

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Deploy platforms
.vercel/
.railway/

# Rust / WASM (fase 4)
target/
pkg/
