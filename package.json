{
  "name": "the-q-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A quantum circuit laboratory in the browser",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "turbo lint typecheck test build && pnpm boundaries"
  },
  "devDependencies": {
    "@qsim/config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
