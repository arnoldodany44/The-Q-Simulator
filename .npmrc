# Workspace packages resolve through the `workspace:` protocol only, never
# from the registry. Without this, a typo in a workspace name silently pulls
# an unrelated (or malicious) package off npm.
link-workspace-packages=false
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Surface peer dependency problems instead of hiding them.
strict-peer-dependencies=false
auto-install-peers=true
