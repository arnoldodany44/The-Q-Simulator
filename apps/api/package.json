    "@qsim/contract": "workspace:*",
    "@qsim/db": "workspace:*",
    "@qsim/schema": "workspace:*",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "jose": "catalog:",
    "nanoid": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@qsim/config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
