{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Q Simulator REST API — Fastify 5 on Railway",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node build.js --watch",
    "start": "node dist/server.js",
    "build": "node build.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@prisma/adapter-pg": "catalog:",
