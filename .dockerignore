# Everything the image builds for itself, plus everything it must never see.
#
# node_modules above all: copying a Windows-installed pnpm store into a Linux
# image ships binaries for the wrong platform, and they win over the ones the
# install would have fetched.
node_modules
**/node_modules
dist
**/dist
.turbo
**/.turbo

# The local environment file. Railway injects its own variables; a copy of the
# developer's .env inside the image would be both wrong and a secret at rest.
.env
.env.*
!.env.example

.git
.github
coverage
**/coverage
playwright-report
test-results
**/*.log

# Generated by prisma generate during the install step.
packages/db/src/generated

# Not needed to build or run the API.
docs
apps/web/e2e
apps/web/public
