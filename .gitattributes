# Normalise line endings. Prettier is configured with endOfLine: lf, so
# without this every file a Windows editor touches shows up as fully
# rewritten in the diff.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated — collapse in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff
