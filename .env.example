# Copy to .env and fill in from each provider's dashboard.
# NEVER commit .env — it is in .gitignore, keep it that way.
#
# Values live in Vercel, Railway and Supabase. This file documents only the
# shape. See docs/plan-de-trabajo.md §6 for which account provides what.

# ─── apps/web (Vercel) ────────────────────────────────────────────────────
# Everything prefixed VITE_ is compiled into the browser bundle and is
# readable by anyone. A secret key must never appear in this block.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_...
VITE_SENTRY_DSN=

# ─── apps/api (Railway) ───────────────────────────────────────────────────
# Arrives with M1.2. Listed now so the shape is settled.
NODE_ENV=development
PORT=8080
WEB_URL=http://localhost:5173

# Supabase pooler, port 6543. The query string is not optional: without
# pgbouncer=true Prisma issues prepared statements that pgBouncer rejects in
# transaction mode, producing intermittent errors that are very hard to trace.
DATABASE_URL=                            # ...:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection, port 5432. Migrations only — prisma migrate cannot run
# through the pooler.
DIRECT_URL=                              # ...:5432/postgres

SUPABASE_URL=
SUPABASE_SECRET_KEY=                     # sb_secret_... — never sent to the frontend

# Verifying user tokens. Supabase projects now sign with ASYMMETRIC keys
# (ES256), so the API holds no shared secret — it fetches the public key from
# the project's JWKS endpoint, which needs no authentication.
# Specification §11 predates this and still describes the legacy HS256 secret;
# the endpoint below is what a current project actually uses.
SUPABASE_JWKS_URL=                       # <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=                     # legacy HS256 only; blank on new projects

REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Encrypts user hardware tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

SENTRY_DSN=

# ─── Not stored here ──────────────────────────────────────────────────────
# GitHub and Google OAuth client IDs/secrets → Supabase dashboard only
#   (Authentication → Providers). The code never sees them.
# IBM Quantum tokens → supplied per user, encrypted into HardwareCredential.
#   There is no project-level hardware credential.
