# Copy to .env and fill in from each provider's dashboard.
# NEVER commit .env — it is in .gitignore, keep it that way.
#
# Values live in Vercel, Railway and Supabase. This file documents only the
# shape. See docs/plan-de-trabajo.md §6 for which account provides what.

# ─── apps/web (Vercel) ────────────────────────────────────────────────────
# Everything prefixed VITE_ is compiled into the browser bundle and is
# readable by anyone. A secret key must never appear in this block.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_...
VITE_SENTRY_DSN=

# ─── apps/api (Railway) ───────────────────────────────────────────────────
# Every variable in this block is parsed with Zod at boot. A missing or
# malformed one refuses to start the service and names itself; it never fails
# later, per request, from inside a driver.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=                               # fatal|error|warn|info|debug|trace
                                         # default: info in production, else debug

# Origin allowed by CORS — an exact allow-list, never a wildcard (§11).
# Comma-separate to allow several (a preview deployment alongside production).
WEB_URL=http://localhost:5173

# Whether X-Forwarded-For is believed. This decides what `request.ip` is, and
# `request.ip` is the rate-limit key for every anonymous caller. Behind
# Railway's edge it must be the hop count `1`, or every anonymous request
# shares the proxy's address and the per-IP limit becomes a global one. With
# no proxy in front it must be `false`, or any client can spoof the header and
# mint a fresh identity per request. `true` is rejected: it trusts the whole
# forwarded chain, which is the unsafe reading of an ambiguous value.
TRUST_PROXY=                             # false | 1 | 10.0.0.1,10.0.0.2
                                         # default: 1 in production, else false

# Rate limiting (§11), per IP for anonymous callers and per user id for
# authenticated ones. The strict budget is for the routes §11 singles out:
# authentication and /simulate.
RATE_LIMIT_MAX=                          # default 300
RATE_LIMIT_WINDOW_MS=                    # default 60000
RATE_LIMIT_STRICT_MAX=                   # default 20

# How long a graceful shutdown may take before the process gives up and
# exits. Bounded because a request stuck on a slow query would otherwise hold
# the shutdown open until the platform sends SIGKILL — which skips the hooks
# entirely and leaks the pooled connection the graceful path exists to release.
SHUTDOWN_TIMEOUT_MS=                     # default 10000

# Supabase TRANSACTION pooler, port 6543 — runtime queries. The query string
# is not optional: connection_limit caps the pool at what the shared pooler
# budgets, and pgbouncer=true keeps Prisma off prepared statements that
# pgBouncer rejects in transaction mode, which otherwise produces intermittent
# errors that are very hard to trace.
DATABASE_URL=                            # ...:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase SESSION pooler, port 5432, with no pgbouncer parameters —
# migrations only, because `prisma migrate` holds advisory locks and runs DDL
# in transactions the 6543 pooler cannot carry.
# Not `db.<ref>.supabase.co`: that host is IPv6-only and unreachable from an
# IPv4-only machine, despite being the one the Supabase dashboard calls
# "direct connection".
DIRECT_URL=                              # ...:5432/postgres

SUPABASE_URL=
SUPABASE_SECRET_KEY=                     # sb_secret_... — never sent to the frontend

# Verifying user tokens. Supabase projects now sign with ASYMMETRIC keys
# (ES256), so the API holds no shared secret — it fetches the public key from
# the project's JWKS endpoint, which needs no authentication.
# Specification §11 predates this and still describes the legacy HS256 secret;
# the endpoint below is what a current project actually uses.
#
# This is the API's trust anchor: whatever that document says is a signing key
# becomes a signing key. It must be https — or http on a loopback host, for a
# local `supabase start` — and the API refuses to boot on anything else,
# because plaintext HTTP here means an on-path attacker can substitute the key
# set and mint a token for any user. Same rule on SUPABASE_URL and the issuer.
SUPABASE_JWKS_URL=                       # <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=                     # legacy HS256 only; blank on new projects
# The `iss` and `aud` claims the API requires. Both are checked, and the
# audience check is the one usually forgotten: a token signed by the right
# key, unexpired, from the right issuer, can still have been minted for a
# different audience in the same project. The issuer defaults to
# <SUPABASE_URL>/auth/v1, so a wrong SUPABASE_URL fails closed rather than
# accepting two projects' tokens.
SUPABASE_JWT_ISSUER=                     # default <SUPABASE_URL>/auth/v1
SUPABASE_JWT_AUDIENCE=                   # default 'authenticated'

REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Encrypts user hardware tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

SENTRY_DSN=

# ─── Opt-in checks ────────────────────────────────────────────────────────
# Set to 1 to let `pnpm --filter @qsim/db test` also query the live database
# and confirm the migrated tables, enums and indexes really exist. Read-only,
# and off by default so the normal test run needs no network and no
# connection from the pooler's small budget.
QSIM_DB_INTROSPECTION=

# ─── Not stored here ──────────────────────────────────────────────────────
# GitHub and Google OAuth client IDs/secrets → Supabase dashboard only
#   (Authentication → Providers). The code never sees them.
# IBM Quantum tokens → supplied per user, encrypted into HardwareCredential.
#   There is no project-level hardware credential.
