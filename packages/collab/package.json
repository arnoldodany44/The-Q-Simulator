{
  "name": "@qsim/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "How a circuit lives inside a Yjs document — the shape shared by the editor and the relay",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@qsim/schema": "workspace:*",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@qsim/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
