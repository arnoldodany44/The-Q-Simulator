{
  "name": "@qsim/transpile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Circuit → device: decomposition into a superconducting native basis, placement on a real coupling map, and the inverse mapping that brings results home",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@qsim/core": "workspace:*",
    "@qsim/qasm": "workspace:*",
    "@qsim/schema": "workspace:*"
  },
  "devDependencies": {
    "@qsim/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
