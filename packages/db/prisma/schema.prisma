// The Q Simulator — data model (specification §7).
//
// Two things about this file are load-bearing and easy to undo by accident.
//
// 1. Prisma owns the `public` schema and nothing else. Supabase owns `auth`,
//    which is why there is no Account model and no User.passwordHash here:
//    identities, password hashes, OAuth links and email verification all live
//    in `auth.users`, and `User.id` below is that table's UUID rather than a
//    cuid we would have to reconcile. A migration that mentions `auth` is a
//    bug — see the test that asserts exactly that.
//
// 2. The circuit itself is JSON in `CircuitVersion.data`, never normalised
//    into gate rows. Nothing ever queries a single gate, and normalising
//    would turn one insert into hundreds. The JSON is validated by
//    `parseCircuit` from @qsim/schema before it is written; Postgres only
//    stores what the contract already accepted.
//
// The denormalised counters (gateCount, depth, starCount, viewCount) and the
// indexes below exist so the gallery can sort and paginate without joining
// CircuitVersion or counting Stars. They are maintained on write.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Prisma 7 generates TypeScript, not a Rust-engine binding, so the output
  // is ordinary source that this package's own compiler options apply to.
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// Two URLs, and they are not interchangeable (§12.6). DATABASE_URL is the
// Supabase transaction pooler on 6543 carrying ?pgbouncer=true — runtime
// queries. DIRECT_URL is the session pooler on 5432 with no pgbouncer
// parameters, because `prisma migrate` holds advisory locks and issues DDL
// that a transaction-mode pooler cannot carry.
//
// Prisma 7 removed `url` and `directUrl` from this block: a datasource in a
// schema file may now declare only its provider. The split did not go away,
// it moved and became stricter — DIRECT_URL is handed to the CLI in
// `prisma.config.ts`, DATABASE_URL is handed to the driver adapter in
// `src/client.ts`, and neither can reach the other's code path by accident.
// Specification §12.6 still shows the Prisma 6 form.
datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

/// One row per Supabase identity. `id` is the UUID Supabase issued, not a
/// value this schema generates — the row is created by `ensureUser` on the
/// first authenticated request (see src/users.ts for why that, and not a
/// trigger on auth.users).
model User {
  id          String   @id @db.Uuid
  email       String   @unique
  username    String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  circuits    Circuit[]
  stars       Star[]
  comments    Comment[]
  collections Collection[]
  submissions ChallengeSubmission[]
  credentials HardwareCredential[]
  apiKeys     ApiKey[]
}

// ─── Circuits ──────────────────────────────────────────────────────────────

/// `cuid(2)` and not `cuid()` throughout this file, and the reason is not
/// fashion. Prisma's `cuid()` is cuid v1: a millisecond timestamp, a
/// process-global monotonic counter, a per-process fingerprint that is
/// constant for the life of the process, and about 41 bits of randomness. Two
/// of those are visible to whoever receives an id, and `POST /circuits`
/// returns one — so a caller can create a circuit, wait, create another, and
/// read the gap in the counter as the number of rows *other tenants* wrote in
/// between. cuid2 is a hash of entropy with no timestamp and no counter, so
/// there is nothing in it to read. The change costs nothing at the database
/// level: these defaults are generated by the client, never by Postgres, so
/// no column definition and no migration is involved.
model Circuit {
  id           String     @id @default(cuid(2))
  ownerId      String     @db.Uuid
  title        String
  description  String?    @db.Text
  visibility   Visibility @default(PRIVATE)
  slug         String     @unique
  qubitCount   Int
  gateCount    Int
  depth        Int
  forkedFromId String?
  starCount    Int        @default(0)
  viewCount    Int        @default(0)
  /// The gallery card's thumbnail — @qsim/schema's `CircuitPreview`, derived
  /// from the head version by `previewOf` on every write, exactly as
  /// gateCount and depth are (M1.5b).
  ///
  /// Denormalised for the same reason those are, and the reason is sharper
  /// here: the gallery is anonymous, it lists up to fifty circuits, and
  /// `CircuitVersion.data` is capped at 256 KiB — so joining the head version
  /// to draw fifty thumbnails would put up to 12 MB behind one request on the
  /// product's front page. A preview is a few hundred bytes, bounded by
  /// PREVIEW_MAX_QUBITS × PREVIEW_MAX_COLUMNS, and rides in the card's own
  /// row.
  ///
  /// Nullable, and it stays nullable: a row written before this column
  /// existed has no thumbnail, and a card that cannot draw one shows the
  /// counters it already has rather than failing. Always read it through
  /// `safeParsePreview`, which answers null for anything it cannot read —
  /// a picture is never worth a 500.
  preview      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFrom   Circuit?         @relation("Forks", fields: [forkedFromId], references: [id])
  forks        Circuit[]        @relation("Forks")
  versions     CircuitVersion[]
  runs         SimulationRun[]
  hardwareJobs HardwareJob[]
  stars        Star[]
  comments     Comment[]
  tags         CircuitTag[]

  // The gallery's two orderings, each covered by its own index so neither
  // needs a join or a sort of the whole table.
  @@index([visibility, starCount])
  @@index([ownerId, updatedAt])
  // ── The gallery's keyset indexes (M1.5) ────────────────────────────────
  //
  // The two above are §7's and are kept because §7 asks for them; these two
  // are what the gallery's *pagination* actually needs. Cursor pagination
  // orders by the whole tie-break tuple — (starCount, createdAt, id) or
  // (createdAt, id) — and an index that stops at `starCount` leaves Postgres
  // sorting every row that shares a star count, which on a gallery is most
  // of them, since most circuits have none.
  //
  // `sort: Desc` matches the ORDER BY rather than relying on a backward
  // scan. Both are equally fast here; spelling it out means the index reads
  // the way the query does.
  @@index([visibility, starCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc), id(sort: Desc)])
  // ── Search (M1.5) ──────────────────────────────────────────────────────
  //
  // Trigram GIN, which is what makes `ILIKE '%term%'` an index lookup
  // instead of a sequential scan of every circuit in the database. Both
  // columns are indexed because the search is `title OR description`, and an
  // OR with one indexed side is a scan of the whole table anyway.
  //
  // Why trigrams and not `tsvector`: see the argument in `src/gallery.ts`.
  // The short of it is that this corpus is trilingual (D2) and a text-search
  // configuration has to pick one language, while trigrams have no opinion
  // about language — and that a person typing "grov" into a search box
  // expects Grover, which a lexeme index cannot give them.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Circuit_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Circuit_description_trgm_idx")
}

/// Immutable history. A save appends a version; it never rewrites one.
model CircuitVersion {
  id         String   @id @default(cuid(2))
  circuitId  String
  versionNum Int
  /// The circuit JSON — the @qsim/schema contract. Always run it through
  /// `parseCircuit` on the way out: Prisma types this as `JsonValue` and
  /// cannot know the shape, and a row written by an older schema version is
  /// exactly the case that must not reach the engine unvalidated.
  data       Json
  message    String?
  createdAt  DateTime @default(now())

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@unique([circuitId, versionNum])
}

// ─── Simulation ────────────────────────────────────────────────────────────

/// A server-side run. `userId` is deliberately not a relation: anonymous runs
/// are allowed, and a run's record outlives the account that asked for it.
model SimulationRun {
  id           String    @id @default(cuid(2))
  circuitId    String?
  userId       String?   @db.Uuid
  mode         SimMode
  shots        Int?
  noiseProfile Json?
  status       RunStatus @default(QUEUED)
  result       Json?
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime  @default(now())

  circuit Circuit? @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ─── Hardware (Fase 4) ─────────────────────────────────────────────────────

/// AES-256-GCM ciphertext and nonce. The plaintext token never lands in a
/// column and is never returned by the API — the read endpoint answers with
/// provider, label and date only (§11).
model HardwareCredential {
  id             String   @id @default(cuid(2))
  userId         String   @db.Uuid
  provider       String
  encryptedToken Bytes
  iv             Bytes
  label          String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HardwareJob {
  id            String    @id @default(cuid(2))
  circuitId     String
  userId        String    @db.Uuid
  provider      String
  backendName   String
  providerJobId String?
  shots         Int
  status        JobStatus @default(SUBMITTED)
  queuePosition Int?
  result        Json?
  errorMessage  String?
  submittedAt   DateTime  @default(now())
  completedAt   DateTime?

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─── Challenges (Fase 3) ───────────────────────────────────────────────────

model Challenge {
  id                String   @id @default(cuid(2))
  slug              String   @unique
  title             String
  prompt            String   @db.Text
  difficulty        Int
  qubitCount        Int
  targetType        String
  targetData        Json
  allowedGates      String[]
  maxGates          Int?
  fidelityThreshold Float    @default(0.99)
  orderIndex        Int

  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id          String   @id @default(cuid(2))
  challengeId String
  userId      String   @db.Uuid
  circuitData Json
  passed      Boolean
  fidelity    Float
  gateCount   Int
  depth       Int
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The leaderboard is "passing submissions for this challenge, fewest gates
  // first", which this index answers end to end.
  @@index([challengeId, passed, gateCount])
}

// ─── Curation ──────────────────────────────────────────────────────────────

/// A curated group of circuits (§3.4), with a visibility of its own.
///
/// Its visibility governs the *collection* and nothing inside it. A PUBLIC
/// collection that holds a PRIVATE circuit does not publish that circuit: the
/// items are read through `listableCircuitFilter` like every other listing, so
/// a stranger sees only the ones they could already have seen, and the rest are
/// withheld and counted. See `src/collections.ts`.
model Collection {
  id          String     @id @default(cuid(2))
  ownerId     String     @db.Uuid
  title       String
  description String?
  visibility  Visibility @default(PRIVATE)
  /// M1.9. §7 gives Collection no timestamps, and a listing needs a total
  /// order it can page through: with neither a timestamp nor a sortable key,
  /// `ORDER BY` has nothing to say and two requests for the same page may
  /// disagree about which rows are on it. `updatedAt` is also the only honest
  /// answer to "what changed recently" on a profile page.
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  /// The owner's own listing and a profile's public one are the same query
  /// with one more predicate — filter on `ownerId` (and, for a stranger,
  /// `visibility`), order by `updatedAt`. Without this index every profile
  /// page sorts every collection in the database.
  @@index([ownerId, updatedAt])
}

model CollectionItem {
  collectionId String
  circuitId    String
  orderIndex   Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, circuitId])
  /// `circuitId` deliberately carries no foreign key (§7), so nothing in
  /// Postgres removes these rows when the circuit they name is deleted — the
  /// application does, in `remove` and in `deleteAccount`. Both of those are
  /// deletes *by circuitId*, and a composite primary key cannot be probed by
  /// its second column, so without this index every circuit deletion is a
  /// sequential scan of the join table.
  @@index([circuitId])
}

model Star {
  userId    String   @db.Uuid
  circuitId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@id([userId, circuitId])
}

model Comment {
  id        String   @id @default(cuid(2))
  circuitId String
  userId    String   @db.Uuid
  body      String   @db.Text
  parentId  String?
  createdAt DateTime @default(now())

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id       String       @id @default(cuid(2))
  name     String       @unique
  circuits CircuitTag[]
}

model CircuitTag {
  circuitId String
  tagId     String

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([circuitId, tagId])
  // The primary key answers "which tags does this circuit have"; the gallery
  // asks the opposite question — "which circuits carry this tag" — and a
  // composite key cannot be probed by its second column. Without this, every
  // `?tag=` request is a sequential scan of the join table.
  @@index([tagId])
}

/// Only the hash is stored, and it is unique so a lookup by presented key is
/// a single indexed read. Revocation is a timestamp, not a delete, so an
/// audit trail survives.
model ApiKey {
  id         String    @id @default(cuid(2))
  userId     String    @db.Uuid
  name       String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum SimMode {
  STATEVECTOR
  DENSITY_MATRIX
  TRAJECTORIES
}

enum RunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum JobStatus {
  SUBMITTED
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}
