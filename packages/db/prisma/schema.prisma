// The Q Simulator — data model (specification §7).
//
// Two things about this file are load-bearing and easy to undo by accident.
//
// 1. Prisma owns the `public` schema and nothing else. Supabase owns `auth`,
//    which is why there is no Account model and no User.passwordHash here:
//    identities, password hashes, OAuth links and email verification all live
//    in `auth.users`, and `User.id` below is that table's UUID rather than a
//    cuid we would have to reconcile. A migration that mentions `auth` is a
//    bug — see the test that asserts exactly that.
//
// 2. The circuit itself is JSON in `CircuitVersion.data`, never normalised
//    into gate rows. Nothing ever queries a single gate, and normalising
//    would turn one insert into hundreds. The JSON is validated by
//    `parseCircuit` from @qsim/schema before it is written; Postgres only
//    stores what the contract already accepted.
//
// The denormalised counters (gateCount, depth, starCount, viewCount) and the
// indexes below exist so the gallery can sort and paginate without joining
// CircuitVersion or counting Stars. They are maintained on write.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Prisma 7 generates TypeScript, not a Rust-engine binding, so the output
  // is ordinary source that this package's own compiler options apply to.
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// Two URLs, and they are not interchangeable (§12.6). DATABASE_URL is the
// Supabase transaction pooler on 6543 carrying ?pgbouncer=true — runtime
// queries. DIRECT_URL is the session pooler on 5432 with no pgbouncer
// parameters, because `prisma migrate` holds advisory locks and issues DDL
// that a transaction-mode pooler cannot carry.
//
// Prisma 7 removed `url` and `directUrl` from this block: a datasource in a
// schema file may now declare only its provider. The split did not go away,
// it moved and became stricter — DIRECT_URL is handed to the CLI in
// `prisma.config.ts`, DATABASE_URL is handed to the driver adapter in
// `src/client.ts`, and neither can reach the other's code path by accident.
// Specification §12.6 still shows the Prisma 6 form.
datasource db {
  provider = "postgresql"
}

// ─── Identity ──────────────────────────────────────────────────────────────

/// One row per Supabase identity. `id` is the UUID Supabase issued, not a
/// value this schema generates — the row is created by `ensureUser` on the
/// first authenticated request (see src/users.ts for why that, and not a
/// trigger on auth.users).
model User {
  id          String   @id @db.Uuid
  email       String   @unique
  username    String   @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  /// "Do not print my name on a challenge leaderboard" (§3.6, Phase 3).
  ///
  /// A leaderboard is the one surface in this product that publishes a list of
  /// *people* rather than of their work, and a circuit's own visibility has
  /// nothing to say about it: solving a puzzle is not publishing anything.
  /// So the listing is refusable, and this column is the refusal.
  ///
  /// Named for the choice and not for the listing, which is why the default is
  /// `false` rather than a `showOnLeaderboard` defaulting to `true`. The two
  /// store the same bit today and answer differently later: with a column
  /// named for the listing, "never expressed a preference" and "asked to be
  /// listed" are the same value, so changing the default would silently
  /// rewrite the stated preference of everybody who had one. Here the default
  /// is the absence of a choice, and a row that says `true` says a person
  /// asked.
  ///
  /// It hides the *row*, never the rank: `challenges.ts` ranks every passing
  /// submission and filters the listing afterwards, so opting out cannot
  /// promote anybody else. See the header there.
  leaderboardOptOut Boolean @default(false)

  circuits    Circuit[]
  customGates CustomGate[]
  stars       Star[]
  comments    Comment[]
  /// Threads this user closed (M5.4). A second, named relation to `Comment`
  /// because `userId` already claims the unnamed one — and it is `SetNull`
  /// rather than `Cascade`: a thread that was resolved stays resolved after the
  /// person who resolved it deletes their account. Cascading here would delete
  /// the conversation instead, which is the opposite of what resolving means.
  resolvedComments Comment[] @relation("CommentResolutions")
  collections Collection[]
  submissions ChallengeSubmission[]
  credentials HardwareCredential[]
  apiKeys     ApiKey[]
  lessons     LessonProgress[]
}

// ─── Circuits ──────────────────────────────────────────────────────────────

/// `cuid(2)` and not `cuid()` throughout this file, and the reason is not
/// fashion. Prisma's `cuid()` is cuid v1: a millisecond timestamp, a
/// process-global monotonic counter, a per-process fingerprint that is
/// constant for the life of the process, and about 41 bits of randomness. Two
/// of those are visible to whoever receives an id, and `POST /circuits`
/// returns one — so a caller can create a circuit, wait, create another, and
/// read the gap in the counter as the number of rows *other tenants* wrote in
/// between. cuid2 is a hash of entropy with no timestamp and no counter, so
/// there is nothing in it to read. The change costs nothing at the database
/// level: these defaults are generated by the client, never by Postgres, so
/// no column definition and no migration is involved.
model Circuit {
  id           String     @id @default(cuid(2))
  ownerId      String     @db.Uuid
  title        String
  description  String?    @db.Text
  visibility   Visibility @default(PRIVATE)
  slug         String     @unique
  qubitCount   Int
  gateCount    Int
  depth        Int
  forkedFromId String?
  starCount    Int        @default(0)
  viewCount    Int        @default(0)
  /// The gallery card's thumbnail — @qsim/schema's `CircuitPreview`, derived
  /// from the head version by `previewOf` on every write, exactly as
  /// gateCount and depth are (M1.5b).
  ///
  /// Denormalised for the same reason those are, and the reason is sharper
  /// here: the gallery is anonymous, it lists up to fifty circuits, and
  /// `CircuitVersion.data` is capped at 256 KiB — so joining the head version
  /// to draw fifty thumbnails would put up to 12 MB behind one request on the
  /// product's front page. A preview is a few hundred bytes, bounded by
  /// PREVIEW_MAX_QUBITS × PREVIEW_MAX_COLUMNS, and rides in the card's own
  /// row.
  ///
  /// Nullable, and it stays nullable: a row written before this column
  /// existed has no thumbnail, and a card that cannot draw one shows the
  /// counters it already has rather than failing. Always read it through
  /// `safeParsePreview`, which answers null for anything it cannot read —
  /// a picture is never worth a 500.
  preview      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFrom   Circuit?         @relation("Forks", fields: [forkedFromId], references: [id])
  forks        Circuit[]        @relation("Forks")
  versions     CircuitVersion[]
  session      CircuitSession?
  runs         SimulationRun[]
  hardwareJobs HardwareJob[]
  stars        Star[]
  comments     Comment[]
  tags         CircuitTag[]

  // The gallery's two orderings, each covered by its own index so neither
  // needs a join or a sort of the whole table.
  @@index([visibility, starCount])
  @@index([ownerId, updatedAt])
  // ── The gallery's keyset indexes (M1.5) ────────────────────────────────
  //
  // The two above are §7's and are kept because §7 asks for them; these two
  // are what the gallery's *pagination* actually needs. Cursor pagination
  // orders by the whole tie-break tuple — (starCount, createdAt, id) or
  // (createdAt, id) — and an index that stops at `starCount` leaves Postgres
  // sorting every row that shares a star count, which on a gallery is most
  // of them, since most circuits have none.
  //
  // `sort: Desc` matches the ORDER BY rather than relying on a backward
  // scan. Both are equally fast here; spelling it out means the index reads
  // the way the query does.
  @@index([visibility, starCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc), id(sort: Desc)])
  // ── Search (M1.5) ──────────────────────────────────────────────────────
  //
  // Trigram GIN, which is what makes `ILIKE '%term%'` an index lookup
  // instead of a sequential scan of every circuit in the database. Both
  // columns are indexed because the search is `title OR description`, and an
  // OR with one indexed side is a scan of the whole table anyway.
  //
  // Why trigrams and not `tsvector`: see the argument in `src/gallery.ts`.
  // The short of it is that this corpus is trilingual (D2) and a text-search
  // configuration has to pick one language, while trigrams have no opinion
  // about language — and that a person typing "grov" into a search box
  // expects Grover, which a lexeme index cannot give them.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Circuit_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Circuit_description_trgm_idx")
}

/// Immutable history. A save appends a version; it never rewrites one.
model CircuitVersion {
  id         String   @id @default(cuid(2))
  circuitId  String
  versionNum Int
  /// The circuit JSON — the @qsim/schema contract. Always run it through
  /// `parseCircuit` on the way out: Prisma types this as `JsonValue` and
  /// cannot know the shape, and a row written by an older schema version is
  /// exactly the case that must not reach the engine unvalidated.
  data       Json
  message    String?
  createdAt  DateTime @default(now())

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@unique([circuitId, versionNum])
}

/// The live CRDT document of a collaborative session — §3.4, Fase 5 (M5.2).
///
/// ── When does a shared session become a version? It does not ──────────────
///
/// This is the model that answers the tension, and the answer is that the two
/// things are different in kind and neither should be made to stand in for the
/// other.
///
/// A **version** is immutable, numbered, carries a message, appears in the
/// history, can be diffed and restored, and is what the gallery, the embed and
/// the simulator read. It exists because a person decided their circuit had
/// reached a state worth naming. A **session** is a continuous stream of
/// keystrokes with no such moment in it. Materialising it into versions on a
/// timer would fill an immutable, user-visible history with rows nobody chose —
/// "restore" would mean "go back four seconds", the diff view would show a gate
/// being dragged, and §3.4's promise that a save creates a version would have
/// quietly become "a save creates a version and so does waiting".
///
/// So a live document lives here instead: one mutable row per circuit, holding
/// the Yjs state. It is deliberately *not* history —
///
///   - it is overwritten in place, so there is nothing to navigate;
///   - nothing reads it except the relay, so no reader can be shown
///     work-in-progress the author never saved;
///   - it is not a `Circuit`'s content. `Circuit.qubitCount`, `gateCount`,
///     `depth` and `preview` stay derived from the head *version*, so a card in
///     the gallery keeps describing what was saved.
///
/// What it buys is the one thing a session genuinely needs from a database:
/// **the document survives everybody leaving.** Two people edit for an hour,
/// both close their laptops without saving, and the next one to open the circuit
/// resumes exactly where they stopped. Without this row that hour is in the
/// memory of a Railway container that redeploys twice a day.
///
/// ── Why the primary key is the circuit ────────────────────────────────────
///
/// A circuit has at most one live document, by definition: two documents for one
/// circuit would be two groups of people editing the same thing and never seeing
/// each other, which is the exact failure collaboration exists to remove. Making
/// `circuitId` the key makes that unrepresentable rather than merely avoided, and
/// makes the relay's read a single primary-key lookup on a connection pool of
/// one.
///
/// ── Why a save clears it ──────────────────────────────────────────────────
///
/// `appendVersion` deletes this row in the same transaction that writes the
/// version, and that one line is what keeps the two stores from disagreeing
/// about which is newer. The case it exists for is **restore**: restoring
/// version 3 appends a new version carrying version 3's circuit, and if the
/// session row survived that, the next session would resume the pre-restore
/// document and the restore would silently undo itself. Deleting is safe in the
/// ordinary case for the same reason it is necessary in that one — the version
/// just written *is* what the document said, so seeding the next session from it
/// loses nothing, and a session still running simply persists again on its next
/// edit.
model CircuitSession {
  circuitId String @id
  /// `Y.encodeStateAsUpdate(doc)` — the merged form of every update the
  /// document has taken, including the tombstones of what was deleted.
  ///
  /// Opaque here, and it must stay opaque: nothing in this package may decide
  /// what it means. It is written by the relay after `validateCircuit` has
  /// accepted the projection, and it is read straight back into a Y.Doc that is
  /// projected and validated again — because a row is not a trust boundary and
  /// this one was last written by a process that may have been an older build.
  ///
  /// Bounded by the relay at `MAX_COLLAB_STATE_BYTES` before it is ever handed
  /// here, so this column cannot grow without end from an editing session.
  state     Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
}

/// A reusable block, saved per user and publishable — §3.1, milestone M2.3.
/// §7 has no model for this; this is the one it needed.
///
/// ── This is a library, not a dependency graph ──────────────────────────────
///
/// A circuit carries its own copy of every definition it uses, inside
/// `CircuitVersion.data.customGates`. Installing a published block *copies* the
/// definition into the document. So a row here is never referenced by a saved
/// circuit, and deleting one — or editing it, or making it private again — can
/// never change, break or silently alter somebody else's circuit.
///
/// The alternative was a real reference, and it fails on the sentence §3.4
/// already settled for forks: a saved version is immutable, and a version whose
/// meaning depends on a row another account can edit is not. It also fails
/// outside the database entirely, because a circuit travels in a URL (D4) and
/// in an exported JSON file, where there is nothing to resolve a reference
/// against.
///
/// What is lost by copying is attribution, and it is recovered here rather
/// than in the document: `forkedFromId` records where an installed copy came
/// from, exactly as `Circuit.forkedFromId` does, and it is a nullable
/// self-relation for the same reason — the source may be deleted, and losing
/// the credit must not take the copy with it.
model CustomGate {
  id           String     @id @default(cuid(2))
  ownerId      String     @db.Uuid
  /// The identifier a circuit uses to call it. Unique per owner, not globally:
  /// two people may both have a `qft`, and the name only has to resolve inside
  /// one document.
  name         String
  /// A human title, free text. `name` is the identifier and has to survive
  /// OpenQASM; this is what a card shows.
  title        String
  description  String?    @db.Text
  visibility   Visibility @default(PRIVATE)
  /// The @qsim/schema `CustomGate` — qubits, params, operations, symbol.
  /// Always read through `parseCustomGate`: Prisma types this as `JsonValue`
  /// and a row written by an older schema version is exactly the case that
  /// must not reach the editor unvalidated.
  definition   Json
  /// Denormalised the same way `Circuit.gateCount` is, and for the same
  /// reason: a library listing sorts and filters on these without reading a
  /// definition per row.
  qubitCount   Int
  paramCount   Int
  gateCount    Int
  forkedFromId String?
  installCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  forkedFrom CustomGate?  @relation("GateForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks      CustomGate[] @relation("GateForks")

  /// One name per owner — what makes "install this into my library" answerable
  /// with a 409 instead of a silent overwrite.
  @@unique([ownerId, name])
  /// The owner's own list, newest first.
  @@index([ownerId, updatedAt])
  /// The public library, paged by the same keyset shape the gallery uses.
  @@index([visibility, updatedAt(sort: Desc), id(sort: Desc)])
}

// ─── Simulation ────────────────────────────────────────────────────────────

/// A server-side run. `userId` is deliberately not a relation: anonymous runs
/// are allowed, and a run's record outlives the account that asked for it.
model SimulationRun {
  id           String    @id @default(cuid(2))
  circuitId    String?
  userId       String?   @db.Uuid
  mode         SimMode
  shots        Int?
  noiseProfile Json?
  status       RunStatus @default(QUEUED)
  result       Json?
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime  @default(now())

  circuit Circuit? @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ─── Hardware (Fase 4) ─────────────────────────────────────────────────────

/// AES-256-GCM ciphertext and nonce. The plaintext token never lands in a
/// column and is never returned by the API — the read endpoint answers with
/// provider, label and date only (§11).
///
/// **Ajuste M4.1**: `encryptedToken` seals a small JSON document rather than a
/// bare token, because an IBM Cloud credential is now *two* values — the API
/// key and the instance CRN — and both are the user's. §7 gives one ciphertext
/// column, and putting the CRN beside it in plaintext would publish which
/// account and which instance a person holds to anybody who can read the table.
/// One sealed document keeps the schema exactly as §7 wrote it and leaks
/// neither half. The shape is versioned inside the plaintext (`secrets.ts`), so
/// a provider whose credential has a third field is a version bump and not a
/// migration.
///
/// There is deliberately no unique constraint on `[userId, provider]`: a person
/// may legitimately hold a personal key and an employer's, and §3.7's whole
/// point is that the cost of a run falls on whoever's allowance was named.
model HardwareCredential {
  id             String   @id @default(cuid(2))
  userId         String   @db.Uuid
  provider       String
  encryptedToken Bytes
  iv             Bytes
  label          String?
  createdAt      DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs HardwareJob[]

  @@index([userId, provider])
}

/// A run on somebody else's machine, which is the thing that makes this table
/// unlike `SimulationRun`: it can take **hours**.
///
/// **Ajuste M4.1**, four columns and one index, each of which exists because a
/// job outlives the process that submitted it:
///
/// - `credentialId` — whose allowance this job is spending. A worker that
///   resumes a job it did not submit has to know which key to poll with, and
///   "the user's credential for this provider" is not an answer when a person
///   holds two. `SetNull` rather than `Cascade`: deleting a credential must not
///   delete the record of what was run with it, and a job whose credential is
///   gone is a job that can no longer be polled — which is a *state*, reported
///   as such, not a row that should vanish.
/// - `program` — the transpiled OpenQASM 3, the layout it was placed on, and
///   the classical register it measures into. It is stored rather than
///   re-derived because re-transpiling would place the circuit against
///   *today's* calibration, and the answer coming back was measured on the
///   qubits chosen yesterday. A layout that disagrees with the job is the
///   silent-wrongness this milestone exists to avoid.
/// - `pollCount` — how many times this job has been asked about. It bounds a
///   poll loop that would otherwise run for ever against a device that never
///   answers, and it makes each poll's queue job id deterministic and unique,
///   which is what stops two workers scheduling the same tick.
/// - `lastPolledAt` — what the resume sweep orders by. Null means "never
///   polled", which sorts first: a job that was submitted and then lost is more
///   urgent than one that is merely slow.
///
/// `queuePosition` stays nullable and is usually null, which is honest rather
/// than unfinished: the current Quantum API's job document carries no per-job
/// position at all. What a person is shown instead is the *device's* queue
/// length, which the backend listing does report and which is the number that
/// decides whether a result arrives today — see `GET /hardware/backends`.
model HardwareJob {
  id            String    @id @default(cuid(2))
  circuitId     String
  userId        String    @db.Uuid
  credentialId  String?
  provider      String
  backendName   String
  providerJobId String?
  shots         Int
  status        JobStatus @default(SUBMITTED)
  queuePosition Int?
  program       Json?
  pollCount     Int       @default(0)
  lastPolledAt  DateTime?
  result        Json?
  errorMessage  String?
  submittedAt   DateTime  @default(now())
  completedAt   DateTime?

  circuit    Circuit             @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  credential HardwareCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  // The resume sweep's index. It reads "non-terminal, least recently polled
  // first" on a timer, and without this it is a sequential scan of every
  // hardware job this system has ever run — on a pooler whose budget is one
  // connection.
  @@index([status, lastPolledAt])
  // How a poll finds the row from the provider's own id, which is the only
  // identifier a webhook or an operator has in hand.
  @@index([providerJobId])
}

// ─── Challenges (Fase 3) ───────────────────────────────────────────────────

model Challenge {
  id                String   @id @default(cuid(2))
  slug              String   @unique
  title             String
  prompt            String   @db.Text
  difficulty        Int
  qubitCount        Int
  targetType        String
  targetData        Json
  allowedGates      String[]
  maxGates          Int?
  fidelityThreshold Float    @default(0.99)
  orderIndex        Int

  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id          String   @id @default(cuid(2))
  challengeId String
  userId      String   @db.Uuid
  circuitData Json
  passed      Boolean
  fidelity    Float
  gateCount   Int
  depth       Int
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The leaderboard is "passing submissions for this challenge, fewest gates
  // first", which this index answers end to end.
  @@index([challengeId, passed, gateCount])
  // ── What §7's index stops short of (Phase 3) ────────────────────────────
  //
  // §3.6 ranks by "fewest gates, THEN least depth", and this table breaks the
  // remaining tie by who got there first — so the ORDER BY is the whole triple
  // and an index that stops at `gateCount` leaves Postgres sorting every row
  // that shares one. On a challenge whose answer is three gates, that is most
  // of them: gate counts on a leaderboard cluster hard, which is exactly why
  // the second and third keys exist. Same argument as the gallery's keyset
  // indexes, and the §7 index above is kept for the same reason the gallery
  // kept its two: §7 asks for it.
  @@index([challengeId, passed, gateCount, depth, createdAt], map: "ChallengeSubmission_leaderboard_idx")
  // "My attempts at this challenge" — the read behind the best-attempt line on
  // the challenge page, and behind the solved marks on the ladder. §7 gives it
  // no index at all, so without this every one of those is a sequential scan
  // of a table that grows by a row per attempt rather than per user.
  @@index([userId, challengeId, createdAt(sort: Desc)], map: "ChallengeSubmission_userId_challengeId_idx")
  // ── One row per user, which is what a leaderboard actually shows ────────
  //
  // The board ranks each person's *best* passing attempt, so the query is a
  // `DISTINCT ON ("userId")` whose inner order is
  // (userId, gateCount, depth, createdAt, id) — none of the indexes above can
  // produce it, because none of them leads with `userId` under a `challengeId`
  // filter. Without this, every leaderboard request sorts the whole passing
  // set of the challenge.
  //
  // `id` is in the key rather than left to the heap: it is the last tiebreak
  // of a *total* order (see `rankingOrder` in src/challenges.ts), and a scan
  // that stopped at `createdAt` would leave two attempts written in the same
  // millisecond to be separated by a sort the planner is free to do either way
  // — which is a ranking that shuffles between two identical requests.
  @@index([challengeId, passed, userId, gateCount, depth, createdAt, id], map: "ChallengeSubmission_best_per_user_idx")
}

/// Where a signed-in reader stopped in a guided lesson (§3.6, Phase 3).
///
/// Three things this table deliberately is not.
///
/// It is not a lesson table. There is no `Lesson` model and there must not be:
/// a lesson is a file in `apps/web` — prose in the i18n catalogs, circuits and
/// objectives in TypeScript — so the set of them changes with a deploy of the
/// client. A row here names a slug that the API never resolves, which is what
/// keeps "add a lesson" from meaning "migrate the database". The cost is that a
/// stale client can leave a bookmark for a lesson nobody can open; that is one
/// unused row, and the reader's own catalog is what decides what is listed.
///
/// It is not a document store. `stepIndex` is a bookmark and the reader's
/// circuit is not here. Keeping the half-built circuit would be a second,
/// unversioned, unlimited copy of `CircuitVersion.data` with §11's visibility
/// question reopened for it; somebody who wants to keep a circuit has
/// `POST /circuits`.
///
/// And it is not a score. Nothing here is ranked, nothing is shown to another
/// reader, and the client — not the server — decides whether a lesson's
/// objective was met. That is the deliberate opposite of `ChallengeSubmission`
/// above, whose whole reason for existing on the server is risk 5, and the
/// difference is that a challenge has a leaderboard and a lesson has nothing
/// to win.
model LessonProgress {
  userId    String   @db.Uuid
  /// The lesson's URL segment in `apps/web`. Not a foreign key — see above.
  slug      String
  /// Zero-based, and bounded by the contract rather than by the lesson, which
  /// this side cannot see.
  stepIndex Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address of the resource is (this caller, this lesson), which is also
  /// exactly what `PUT /lessons/:slug/progress` upserts on — so the primary key
  /// is the uniqueness constraint rather than a second index beside a surrogate
  /// id, and the only listing that exists (`GET /lessons/progress`) is a prefix
  /// scan of it.
  @@id([userId, slug])
}

// ─── Curation ──────────────────────────────────────────────────────────────

/// A curated group of circuits (§3.4), with a visibility of its own.
///
/// Its visibility governs the *collection* and nothing inside it. A PUBLIC
/// collection that holds a PRIVATE circuit does not publish that circuit: the
/// items are read through `listableCircuitFilter` like every other listing, so
/// a stranger sees only the ones they could already have seen, and the rest are
/// withheld and counted. See `src/collections.ts`.
model Collection {
  id          String     @id @default(cuid(2))
  ownerId     String     @db.Uuid
  title       String
  description String?
  visibility  Visibility @default(PRIVATE)
  /// M1.9. §7 gives Collection no timestamps, and a listing needs a total
  /// order it can page through: with neither a timestamp nor a sortable key,
  /// `ORDER BY` has nothing to say and two requests for the same page may
  /// disagree about which rows are on it. `updatedAt` is also the only honest
  /// answer to "what changed recently" on a profile page.
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  /// The owner's own listing and a profile's public one are the same query
  /// with one more predicate — filter on `ownerId` (and, for a stranger,
  /// `visibility`), order by `updatedAt`. Without this index every profile
  /// page sorts every collection in the database.
  @@index([ownerId, updatedAt])
}

model CollectionItem {
  collectionId String
  circuitId    String
  orderIndex   Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, circuitId])
  /// `circuitId` deliberately carries no foreign key (§7), so nothing in
  /// Postgres removes these rows when the circuit they name is deleted — the
  /// application does, in `remove` and in `deleteAccount`. Both of those are
  /// deletes *by circuitId*, and a composite primary key cannot be probed by
  /// its second column, so without this index every circuit deletion is a
  /// sequential scan of the join table.
  @@index([circuitId])
}

model Star {
  userId    String   @db.Uuid
  circuitId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@id([userId, circuitId])
}

/// A comment, and — from M5.4 (§14, Fase 5) — the gate it is about.
///
/// ── `anchorOpId` is an operation id, and that is the whole design ─────────
///
/// It holds `operations[].id` from §6, never a coordinate. A coordinate anchor
/// silently comes to point at a different gate the first time a column is
/// inserted before it, which is worse than losing the comment: the reader is
/// shown a stranger's sentence about the gate in front of them, attributed to
/// somebody who never said it. An id survives a move, a qubit reorder and a
/// column insertion because the editor never rewrites it, and it can never
/// point at the *wrong* gate because a new operation never receives an id that
/// is in use.
///
/// `NULL` means the comment is about the circuit as a whole, which is what
/// §3.4's comments were before this milestone. The anchor is an addition, not a
/// replacement.
///
/// There is deliberately no foreign key and no `orphaned` flag. The operation
/// lives inside a `jsonb` document, so no key is possible — and none is wanted:
/// whether an anchor resolves depends on *which* document is being displayed
/// (the head version, an older version, the live CRDT session, an unsaved
/// buffer), and those four disagree. So the column records what the comment is
/// about and the reader decides whether that thing is present. The full
/// argument, including why this makes delete-then-undo work for free, is in
/// `@qsim/contract`'s `comments.ts`.
///
/// ── `parentId` finally has a key behind it ────────────────────────────────
///
/// It is `Comment.parentId` → `Comment.id` with `ON DELETE CASCADE`. Until
/// M5.4 this column carried no key at all, and `accounts.ts` compensated with a
/// breadth-first sweep that deleted replies by hand before the `User` row went
/// — a loop whose own comment said the real fix belonged to the milestone that
/// added comment routes. This is that milestone, and the sweep is gone.
///
/// Threads are two levels by application rule (a reply may not be replied to;
/// see the response shape in `@qsim/contract`), so the cascade is one level
/// deep in practice. The key is what makes it correct anyway.
///
/// ── Resolution is on the root ─────────────────────────────────────────────
///
/// `resolvedAt` and `resolvedById` are only ever set on a comment with no
/// `parentId`, because resolving is a statement about a conversation and not
/// about a sentence inside one. A resolved thread is not deleted and not
/// hidden: it stays in the listing with the date on it, because "we discussed
/// this and decided" is the value.
model Comment {
  id           String    @id @default(cuid(2))
  circuitId    String
  userId       String    @db.Uuid
  body         String    @db.Text
  parentId     String?
  anchorOpId   String?
  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  circuit    Circuit   @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  resolvedBy User?     @relation("CommentResolutions", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// The panel's own query: the threads of one circuit, oldest first, because a
  /// conversation reads in the order it happened. Without this, opening a
  /// circuit page scans every comment in the database.
  @@index([circuitId, createdAt])

  /// "Which threads are on this gate", which is what clicking a marker asks,
  /// and — with `createdAt` off the end — the tally that draws every marker at
  /// once. A composite starting at `circuitId` serves both because the anchor
  /// question is never asked across circuits.
  @@index([circuitId, anchorOpId])

  /// Two jobs. It is how a thread's replies are fetched, and it is what keeps
  /// the new cascade from scanning the table on every comment deletion — a
  /// referencing column with no index makes `ON DELETE CASCADE` a sequential
  /// scan, which Postgres does not warn about.
  @@index([parentId])
}

model Tag {
  id       String       @id @default(cuid(2))
  name     String       @unique
  circuits CircuitTag[]
}

model CircuitTag {
  circuitId String
  tagId     String

  circuit Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([circuitId, tagId])
  // The primary key answers "which tags does this circuit have"; the gallery
  // asks the opposite question — "which circuits carry this tag" — and a
  // composite key cannot be probed by its second column. Without this, every
  // `?tag=` request is a sequential scan of the join table.
  @@index([tagId])
}

/// Only the hash is stored, and it is unique so a lookup by presented key is
/// a single indexed read. Revocation is a timestamp, not a delete, so an
/// audit trail survives.
///
/// Three columns are added by M4.2 (§3.5), and each one is load-bearing:
///
/// `keyPrefix` is the first ten characters of the key in the clear — `qsk_`
/// plus six — and it is the only part of the secret that is ever stored
/// readable. It is what makes a listing usable: a person with six keys and
/// stale labels can otherwise not tell which row is the one in their CI job,
/// and a revocation nobody dares perform is a leak nobody closes. Six base64url
/// characters of a 256-bit secret leave 222 bits, which is not a number that
/// gets smaller in any way that matters. The full argument is in
/// `@qsim/contract`'s `api-keys.ts`.
///
/// `scopes` is `TEXT[]` and not an enum, deliberately. A Postgres enum cannot
/// gain a value without `ALTER TYPE`, which is a migration in the one column
/// most likely to grow — and an unknown string read back from this array is
/// *dropped* by `isApiKeyScope` rather than trusted, so the widest thing a
/// future value can do here is grant nothing. Deny-by-default survives the
/// looser column type; it would not survive a client that had to be taught
/// every value before it could parse a row.
///
/// The index is `[userId, revokedAt]`, which is the shape of both questions
/// this table is asked outside the hash lookup: list one account's keys, and
/// count the live ones before minting another.
model ApiKey {
  id         String    @id @default(cuid(2))
  userId     String    @db.Uuid
  name       String
  keyHash    String    @unique
  /// The displayable head of the key. Never enough of it to be a credential.
  keyPrefix  String    @default("")
  /// What this key may do. Empty grants nothing, which is the safe default for
  /// any row written before this column existed.
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum SimMode {
  STATEVECTOR
  DENSITY_MATRIX
  TRAJECTORIES
}

enum RunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum JobStatus {
  SUBMITTED
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}
