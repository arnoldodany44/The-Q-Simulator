{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /*
     * Declarations only, the same arrangement as packages/schema and
     * packages/qsim: runtime consumers resolve this package's source through
     * the `development` export condition (so Vite hot-reloads it), while type
     * resolution goes to `dist/`. No consumer ever compiles these files under
     * its own compiler options.
     */
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  /*
   * `src/testing/` holds fixtures shared between test files, the same
   * arrangement packages/qsim uses: a test file cannot be imported from another
   * without executing its `describe` blocks, and a random-circuit generator is
   * needed by the round-trip suite and by the endianness verification alike.
   * Excluded here and never re-exported from index.ts, so no consumer can
   * reach it.
   */
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
